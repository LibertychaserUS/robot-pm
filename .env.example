# Placeholders only. Export these in the shell before running the editor.
# Do not put real Feishu credentials in this repository.
FEISHU_APP_ID=cli_example_app_id
FEISHU_APP_SECRET=example_app_secret
FEISHU_ENCRYPT_KEY=example_encrypt_key
FEISHU_VERIFICATION_TOKEN=example_verification_token
FEISHU_BITABLE_APP_TOKEN=example_bitable_app_token
FEISHU_BITABLE_TABLE_ID=tbl_example
# Optional. Defaults to https://open.feishu.cn
# FEISHU_BASE_URL=https://open.feishu.cn
# Optional. Default data directory is var/robot_pm under the working directory.
# ROBOT_PM_DATA_ROOT=var/robot_pm
# Optional. Deadlines use Asia/Shanghai unless this names another IANA zone.
# ROBOT_PM_TIMEZONE=Asia/Shanghai
